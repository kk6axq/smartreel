# For PCBs designed using KiCad: https://www.kicad.org/
# Format documentation: https://kicad.org/help/file-formats/

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*-cache*
*-bak
*-bak*
*~
~*
_autosave-*
\#auto_saved_files\#
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
~*.lck
\#auto_saved_files#

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Exported BOM files
*.xml
*.csv

# Archived Backups (KiCad 6.0)
**/*-backups/*.zip

# Local git-based history (KiCad 9.0+)
.history

# Local project settings
*.kicad_prl

# Per-machine Claude Code session state.
.claude/

# PlatformIO build output (firmware projects)
.pio/
**/.pio/

# Python virtualenvs / caches (mock server, scripts)
.venv/
**/.venv/
__pycache__/
*.pyc
*.egg-info/

# Per-machine shell / editor / tooling state
.bash_profile
.bashrc
.profile
.zprofile
.zshrc
.gitconfig
.ripgreprc
.idea/
.vscode/
.mcp.json
*.log

# Large 3D / fabrication exports and generated label assets (kept out of git)
*.step
*.stp
labels/*.pdf
labels/*.dxf

# KiCad working copies / backups
*working_backup*
*_predupe*
SmartReel V2.kicad_pcb

# IDE / editor
.idea/
.vscode/

# Host-test build output
tests/build/
